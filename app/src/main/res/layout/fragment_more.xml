<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/riau_green"
            app:titleTextColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservasi Tiket Wisata Cepat"
                android:textColor="@color/riau_green"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNamaPemesan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_container"
                android:hint="Nama Lengkap Pemesan"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etTujuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_container"
                android:hint="Nama Destinasi Wisata"
                android:inputType="text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPesanTiket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/riau_green"
                android:text="Konfirmasi Reservasi"
                app:cornerRadius="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#E0E0E0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPortalPariwisata"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buka Portal Pariwisata Riau (WebView)"
                android:textColor="@color/riau_green"
                app:cornerRadius="10dp"
                app:strokeColor="@color/riau_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#D32F2F"
                android:text="Keluar Akun (Logout)"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>